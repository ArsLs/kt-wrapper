# Copy to .env and fill in. Never commit .env.
# Keitaro Admin API base URL, including the /admin_api/v1 path.
KT_ADMIN_API_URL=https://keitaro.example.com/admin_api/v1
KT_ADMIN_API_KEY=change-me

# Optional overrides (defaults shown). DATABASE_URL is for local development.
# DATABASE_URL=postgresql+asyncpg://kt:kt@localhost:5432/kt_wrapper
# LOG_LEVEL=INFO

.PHONY: up down db dev-api dev-web lint fmt test migrate revision

up:        ## Build and start postgres + app on http://localhost:8000
	docker compose up --build

down:      ## Stop containers (keeps the DB volume)
	docker compose down

db:        ## Start only postgres (for local dev and tests)
	docker compose up -d postgres

dev-api:   ## Backend with autoreload; settings come from .env
	uv run python -m app --reload

dev-web:   ## Vite dev server on :5173, proxies /api to :8000
	npm --prefix frontend run dev

lint:      ## ruff + mypy + oxlint + tsc
	uv run ruff check .
	uv run ruff format --check .
	uv run mypy
	npm --prefix frontend run lint
	npm --prefix frontend run typecheck

fmt:       ## Autofix lint and format Python
	uv run ruff check --fix .
	uv run ruff format .

test:      ## pytest with coverage (needs `make db`)
	uv run pytest --cov

migrate:   ## Apply migrations to DATABASE_URL
	uv run alembic upgrade head

revision:  ## New autogenerated migration: make revision m="add campaigns"
	uv run alembic revision --autogenerate -m "$(m)"
